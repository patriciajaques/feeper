<%@page language="java" contentType="text/html; charset=ISO-8859-1" pageEncoding="ISO-8859-1"%>
<c:if test="${isPagerVisible}">
<ul class="pagination pagination-sm">
<c:choose>
    <c:when test="${isFirstPage}">
        <li class="disabled"><a href="#">&lt;&lt;</a></li>
        <li class="disabled"><a href="#">&lt;</a></li>
    </c:when>
    <c:otherwise>
        <li><a href="#" onclick="goToPage(1);">&lt;&lt;</a></li>
        <li><a href="#" onclick="goToPage(${previousPage});">&lt;</a></li>
    </c:otherwise>
</c:choose>
${GetPages}
<c:choose>
    <c:when test="${isLastPage}">
        <li class="disabled"><a href="#">&gt;</a></li>
        <li class="disabled"><a href="#">&gt;&gt;</a></li>
    </c:when>
    <c:otherwise>
        <li><a href="#" onclick="goToPage(${nextPage});">&gt;</a></li>
        <li><a href="#" onclick="goToPage(${lastPage});">&gt;&gt;</a></li>
    </c:otherwise>
</c:choose>
</ul>
</c:if>