        </property>
        <property name="operationType" type="int">
            <column name="OperationType"/>
        </property>
        <property name="expectedOutputType" type="string">
            <column length="200" name="ExpectedOutputType"/>
        </property>
        <property name="expectedOutputName" type="string">
            <column length="200" name="ExpectedOutputName"/>
        </property>
        <property name="comparisionType" type="int">
            <column name="ComparisionType"/>
        </property>
        <property name="objectName" type="string">
            <column length="200" name="ObjectName"/>
        </property>
        <property name="methodName" type="string">
            <column length="200" name="MethodName"/>
        </property>
    </class>
</hibernate-mapping>
