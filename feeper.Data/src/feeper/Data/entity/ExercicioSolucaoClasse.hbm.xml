<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class catalog="feeper" name="feeper.Data.entity.ExercicioSolucaoClasse" table="ExercicioSolucaoClasse">
        <id name="id" type="java.lang.Integer">
            <column name="ID"/>
            <generator class="identity"/>
        </id>
        <property name="idSolucao" type="java.lang.Integer">
            <column name="IdSolucao" not-null="true"/>
        </property>  
        <property name="nomeClasse" type="string">
            <column length="200" name="NomeClasse"/>
        </property>
        <property name="codigo" type="string">
            <column  name="Codigo" length="16777215"/>
        </property>
    </class>
</hibernate-mapping>
