<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="feeper.Data.entity.ExercicioSolucao" table="ExercicioSolucao" catalog="feeper">
        <id name="id" type="int">
            <column name="ID" />
            <generator class="identity" />
        </id>
        <property name="idExercicio" type="int">
            <column name="IdExercicio" not-null="true" />
        </property>
        <property name="idAluno" type="int">
            <column name="IdAluno" not-null="true" />
        </property>
        <property name="idStatus" type="int">
            <column name="IdStatus" not-null="true"/>
        </property>
        <property name="dataCadastro" type="timestamp">
            <column length="19" name="DataCadastro" not-null="true"/>
        </property>
        <property name="errosCount" type="int">
            <column name="ErrosCount" not-null="true"/>
        </property>
    </class>
</hibernate-mapping>
