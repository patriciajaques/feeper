<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="feeper.Data.entity.ExercicioInterfaceMembro"  table="ExercicioInterfaceMembro">
        <id name="id" type="int">
            <column name="ID"/>
            <generator class="identity"/>
        </id>
        <property name="idInterface" type="int">
            <column name="IdInterface" not-null="true"/>
        </property>
        <property name="memberType" type="int">
            <column name="MemberType" not-null="true"/>
        </property>
        <property name="modifier" type="int">
            <column name="Modifier" not-null="true"/>
        </property>          
        <property name="type" type="string">
            <column length="200" name="Type"/>
        </property>
        <property name="name" type="string">
            <column length="200" name="Name"/>
        </property>
    </class>
</hibernate-mapping>
