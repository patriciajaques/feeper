<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class  name="feeper.Data.entity.ConfiguracaoSistema"  table="ConfiguracaoSistema" catalog="feeper" >
        <id name="id" type="java.lang.Integer">
            <column name="ID" />
            <generator class="identity" />
        </id>
        <property name="enderecoSistemaCorretorJava" type="string">
            <column name="EnderecoSistemaCorretorJava" length="1000" not-null="true" />
        </property>
    </class>
</hibernate-mapping>
