<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="feeper.Data.entity.MensagemPersonalizada" table="MensagemPersonalizada" catalog="feeper">
        <id name="id" type="int">
            <column name="ID" />
            <generator class="identity" />
        </id>
        <property name="idAutor" type="int">
            <column name="IdAutor" not-null="true" />
        </property> 
        <property name="mensagemPersonalizada" type="string">
            <column name="MensagemPersonalizada" length="10000" />
        </property>
    </class>
</hibernate-mapping>
