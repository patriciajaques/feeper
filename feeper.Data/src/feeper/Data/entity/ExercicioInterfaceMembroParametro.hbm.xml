<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="feeper.Data.entity.ExercicioInterfaceMembroParametro" table="ExercicioInterfaceMembroParametro">
        <id name="id" type="int">
            <column name="ID"/>
            <generator class="identity"/>
        </id>
        <property name="idMembro" type="int">
            <column name="IdMembro" not-null="true"/>
        </property>
        <property name="ordem" type="int">
            <column name="Ordem"/>
        </property>
        <property name="type" type="string">
            <column length="200" name="Type"/>
        </property>
        <property name="name" type="string">
            <column length="200" name="Name"/>
        </property>
    </class>
</hibernate-mapping>
