<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
  <session-factory>
    <property name="hibernate.dialect">org.hibernate.dialect.MySQLInnoDBDialect</property>
    <property name="hibernate.connection.driver_class">com.mysql.jdbc.Driver</property>
    <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/feeper?zeroDateTimeBehavior=convertToNull</property>
    <property name="hibernate.connection.username">root</property>
    <property name="hibernate.show_sql">true</property>
    <property name="hibernate.query.factory_class">org.hibernate.hql.ast.ASTQueryTranslatorFactory</property>
    <property name="hibernate.current_session_context_class">jta</property>
    <property name="hibernate.cache.use_second_level_cache">false</property>
    <property name="hibernate.cache.use_query_cache">false</property>
    <!-- Disable the second-level cache  -->
    <property name="cache.provider_class">org.hibernate.cache.NoCacheProvider</property>
    <mapping resource="feeper/Data/entity/Conquista.hbm.xml"/>
    <mapping resource="feeper/Data/entity/Mensagem.hbm.xml"/>
    <mapping resource="feeper/Data/entity/Exercicio.hbm.xml"/>
    <mapping resource="feeper/Data/entity/MensagemLeitor.hbm.xml"/>
    <mapping resource="feeper/Data/entity/Grade.hbm.xml"/>
    <mapping resource="feeper/Data/entity/PessoaConquista.hbm.xml"/>
    <mapping resource="feeper/Data/entity/Log.hbm.xml"/>
    <mapping resource="feeper/Data/entity/TipoMarcacao.hbm.xml"/>
    <mapping resource="feeper/Data/entity/Turma.hbm.xml"/>
    <mapping resource="feeper/Data/entity/Novidade.hbm.xml"/>
    <mapping resource="feeper/Data/entity/TipoLog.hbm.xml"/>
    <mapping resource="feeper/Data/entity/MensagemCabecalho.hbm.xml"/>
    <mapping resource="feeper/Data/entity/TurmaExercicio.hbm.xml"/>
    <mapping resource="feeper/Data/entity/CodigoFonteMarcacao.hbm.xml"/>
    <mapping resource="feeper/Data/entity/TipoNovidade.hbm.xml"/>
    <mapping resource="feeper/Data/entity/MensagemComentario.hbm.xml"/>
    <mapping resource="feeper/Data/entity/MensagemCurtir.hbm.xml"/>
    <mapping resource="feeper/Data/entity/TurmaPessoa.hbm.xml"/>
    <mapping resource="feeper/Data/entity/ExercicioValidacao.hbm.xml"/>
    <mapping resource="feeper/Data/entity/StatusResposta.hbm.xml"/>
    <mapping resource="feeper/Data/entity/CodigoFonte.hbm.xml"/>
    <mapping resource="feeper/Data/entity/Pessoa.hbm.xml"/>
    <mapping resource="feeper/Data/entity/UploadTemp.hbm.xml"/>
    <mapping resource="feeper/Data/entity/TelaPerfil.hbm.xml"/>
    <mapping resource="feeper/Data/entity/Tela.hbm.xml"/>
    <mapping resource="feeper/Data/entity/Perfil.hbm.xml"/>
    <mapping resource="feeper/Data/entity/Resposta.hbm.xml"/>
    <mapping resource="feeper/Data/entity/RespostaCodigoFonte.hbm.xml"/>
  </session-factory>
</hibernate-configuration>
