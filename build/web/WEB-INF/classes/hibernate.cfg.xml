<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
  <session-factory>
    <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>
    <property name="hibernate.connection.driver_class">com.mysql.jdbc.Driver</property>
    <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/feeper?zeroDateTimeBehavior=convertToNull</property>
    <property name="hibernate.connection.username">root</property>
    <property name="hibernate.show_sql">true</property>
    <property name="hibernate.query.factory_class">org.hibernate.hql.ast.ASTQueryTranslatorFactory</property>
    <property name="hibernate.current_session_context_class">jta</property>
    <mapping resource="feeper/entity/Conquista.hbm.xml"/>
    <mapping resource="feeper/entity/Mensagem.hbm.xml"/>
    <mapping resource="feeper/entity/Exercicio.hbm.xml"/>
    <mapping resource="feeper/entity/MensagemLeitor.hbm.xml"/>
    <mapping resource="feeper/entity/Grade.hbm.xml"/>
    <mapping resource="feeper/entity/PessoaConquista.hbm.xml"/>
    <mapping resource="feeper/entity/Log.hbm.xml"/>
    <mapping resource="feeper/entity/NivelDificuldade.hbm.xml"/>
    <mapping resource="feeper/entity/TipoMarcacao.hbm.xml"/>
    <mapping resource="feeper/entity/Turma.hbm.xml"/>
    <mapping resource="feeper/entity/TipoLog.hbm.xml"/>
    <mapping resource="feeper/entity/Novidade.hbm.xml"/>
    <mapping resource="feeper/entity/MensagemCabecalho.hbm.xml"/>
    <mapping resource="feeper/entity/TurmaExercicio.hbm.xml"/>
    <mapping resource="feeper/entity/TipoNovidade.hbm.xml"/>
    <mapping resource="feeper/entity/CodigoFonteMarcacao.hbm.xml"/>
    <mapping resource="feeper/entity/MensagemComentario.hbm.xml"/>
    <mapping resource="feeper/entity/MensagemCurtir.hbm.xml"/>
    <mapping resource="feeper/entity/ExercicioValidacao.hbm.xml"/>
    <mapping resource="feeper/entity/StatusCodigoFonte.hbm.xml"/>
    <mapping resource="feeper/entity/CodigoFonte.hbm.xml"/>
    <mapping resource="feeper/entity/Pessoa.hbm.xml"/>
    <mapping resource="feeper/entity/TurmaPessoa.hbm.xml"/>
  </session-factory>
</hibernate-configuration>
